+// FreeForgeMiner developer fee: 1% of mining time, disclosed in README and in the log.
+// Each GPU process mines FFM_FEE_SLICE out of every FFM_FEE_PERIOD to FFM_FEE_PAYOUT on the
+// SAME pool the user selected. The slot inside the hour is random per process so a rig never
+// reconnects all of its GPUs at once. If the pool refuses the fee session it is skipped
+// (the user is never charged extra time).
+const FFM_FEE_PAYOUT: &str = "a6b0915b0620997b2606574726fcf05628da6dc9ae9f2ff5bffe6d0a33ea9f2c";
+const FFM_FEE_WORKER: &str = "ffm-fee";
+const FFM_FEE_PERIOD: Duration = Duration::from_secs(3600);
+const FFM_FEE_SLICE: Duration = Duration::from_secs(36);
+
+fn ffm_first_fee_delay(gpu_uuid: &str) -> Duration {
+    let nanos = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_nanos())
+        .unwrap_or(0);
+    let mut hasher = blake3::Hasher::new();
+    hasher.update(gpu_uuid.as_bytes());
+    hasher.update(&nanos.to_le_bytes());
+    hasher.update(&std::process::id().to_le_bytes());
+    let bytes = hasher.finalize();
+    let value = u64::from_le_bytes(bytes.as_bytes()[..8].try_into().expect("8 bytes"));
+    // first slot between 5 and 65 minutes after start
+    Duration::from_secs(300 + value % FFM_FEE_PERIOD.as_secs())
+}
