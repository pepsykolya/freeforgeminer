+// cp.async with compile-time offsets on both addresses: ptxas folds them into the instruction
+// instead of a 64-bit add per copy.
+template <int DestinationOffset, int SourceOffset>
+__device__ __forceinline__ void cp_async_16_at(uint32_t destination, const void* source) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 800
+    asm volatile("cp.async.cg.shared.global [%0+%2], [%1+%3], 16;\n" ::"r"(destination),
+                 "l"(source), "n"(DestinationOffset), "n"(SourceOffset));
+#endif
+}
+
+template <int First, int Count, typename F>
+__device__ __forceinline__ void static_for(F&& f) {
+    if constexpr (Count > 0) {
+        f(std::integral_constant<int, First>{});
+        static_for<First + 1, Count - 1>(f);
+    }
+}
