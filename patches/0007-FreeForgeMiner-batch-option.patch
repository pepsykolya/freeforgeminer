+        Some(value) => bail!("--batch must be 1-64 (got {value})"),
+        None => ffm_auto_batch(&gpu.uuid),
+    };
+    println!(
+        "Batch: {batch_size} forwards per GPU pass{}",
+        if options.batch.is_some() { "" } else { " (auto)" }
+    );
+    FFM_BATCH.store(batch_size, std::sync::atomic::Ordering::Relaxed);
     let searcher = ProductionV4PersistentPoolSearcher::start(production_v4_pool_searcher_config(
         &options.replay_worker,
         &options.model_bank,
         &options.scratch_directory,
-        PRODUCTION_V4_POOL_SEARCH_BATCH_SIZE,
+        batch_size,
