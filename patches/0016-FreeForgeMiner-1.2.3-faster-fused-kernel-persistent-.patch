+// Montgomery arithmetic (R = 2^32) for the epilogue: one 32-bit reduction per product instead
+// of a 64-bit Barrett quotient estimate. p * MONT_NEG_INV == -1 (mod 2^32).
+constexpr uint32_t MONT_NEG_INV = 0x7effffffU;
+static_assert(uint32_t(KOALA_BEAR_MODULUS * MONT_NEG_INV) == 0xffffffffU, "Montgomery inverse");
+constexpr uint32_t pow2_mod_p(uint32_t exponent) {
+    uint64_t r = 1;
+    for (uint32_t i = 0; i < exponent; ++i) r = (r * 2) % KOALA_BEAR_MODULUS;
+    return static_cast<uint32_t>(r);
+}
+constexpr uint32_t MONT_R6 = pow2_mod_p(192);  // R^6 mod p
+static_assert(MONT_R6 == 0x7b9d44cdU, "R^6 mod p");
+
+// x * R^-1 mod p, canonical, for x < 2^62: (x + m * p) / R < 2^30 + p < 2p
+__device__ __forceinline__ uint32_t mont_reduce(uint64_t x) {
+    const uint32_t m = static_cast<uint32_t>(x) * MONT_NEG_INV;
+    const uint32_t r = static_cast<uint32_t>((x + uint64_t(m) * KOALA_BEAR_MODULUS) >> 32);
+    return r >= KOALA_BEAR_MODULUS ? r - KOALA_BEAR_MODULUS : r;
+}
+
+__device__ __forceinline__ uint32_t mont_mul(uint32_t a, uint32_t b) {
+    return mont_reduce(uint64_t(a) * b);
+}
+
+// (x mod p)^3, canonical, for |x| < 2^53 (see canonical_dot): with y = x R^-1,
+// ((y^2 R^-1) y R^-1) R^6 R^-1 = x^3. Same value as cube_fast(canonical_dot(x)).
+__device__ __forceinline__ uint32_t cube_of_dot(int64_t x) {
+    constexpr int64_t bias = int64_t(KOALA_BEAR_MODULUS) << 23;
+    const uint32_t y = mont_reduce(static_cast<uint64_t>(x + bias));
+    return mont_mul(mont_mul(mont_mul(y, y), y), MONT_R6);
+}
+
+constexpr uint32_t pow_mod_p(uint32_t base, uint64_t exponent) {
+    uint64_t result = 1, b = base % KOALA_BEAR_MODULUS;
+    for (; exponent != 0; exponent >>= 1) {
+        if (exponent & 1) result = result * b % KOALA_BEAR_MODULUS;
+        b = b * b % KOALA_BEAR_MODULUS;
+    }
+    return static_cast<uint32_t>(result);
+}
+// Limb weights of the epilogue: the dot is accumulated as sum(acc_j * K 2^(8j)) mod p, so the
+// first Montgomery reduction yields y = D K R^-1 and two Montgomery products give
+// y^3 R^-2 = D^3 K^3 R^-5. With K^3 = R^5 that is D^3 itself. K exists because 3 does not
+// divide p - 1 (cubing permutes the field): K = (R^5)^(1/3), 1/3 taken modulo p - 1.
+constexpr uint64_t INV3_MOD_P_MINUS_1 = (2 * uint64_t(KOALA_BEAR_MODULUS - 1) + 1) / 3;
+static_assert(3 * INV3_MOD_P_MINUS_1 % (KOALA_BEAR_MODULUS - 1) == 1, "1/3 mod p-1");
+constexpr uint32_t MONT_R = pow2_mod_p(32);
+constexpr uint32_t LIMB_K = pow_mod_p(pow_mod_p(MONT_R, 5), INV3_MOD_P_MINUS_1);
+static_assert(pow_mod_p(LIMB_K, 3) == pow_mod_p(MONT_R, 5), "K^3 = R^5");
+constexpr uint32_t LIMB_KR = uint32_t(uint64_t(LIMB_K) * MONT_R % KOALA_BEAR_MODULUS);
+__constant__ int32_t LIMB_WEIGHT[4] = {
+    int32_t(LIMB_K), int32_t(uint64_t(LIMB_K) * 256 % KOALA_BEAR_MODULUS),
+    int32_t(uint64_t(LIMB_K) * 65536 % KOALA_BEAR_MODULUS),
+    int32_t(uint64_t(LIMB_K) * 16777216 % KOALA_BEAR_MODULUS)};
+
+// a * b + c with a 32 x 32 -> 64-bit signed product (one IMAD.WIDE)
+__device__ __forceinline__ int64_t mad_wide(int32_t a, int32_t b, int64_t c) {
+    int64_t d;
+    asm("mad.wide.s32 %0, %1, %2, %3;" : "=l"(d) : "r"(a), "r"(b), "l"(c));
+    return d;
+}
