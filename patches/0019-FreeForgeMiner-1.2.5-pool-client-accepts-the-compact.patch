+/// A reconnect negotiates afresh: the same config talks to a pre-fork pool, then to the
+/// upgraded one, and each session reports the identity it actually selected.
+#[test]
+fn compact_pool_compatibility_reconnect_negotiates_each_identity() {
+    let mut seen = Vec::new();
+    for advertised in [COMPACT_MAINNET_PREDECESSOR_FINGERPRINT, compact(), COMPACT_MAINNET_PREDECESSOR_FINGERPRINT] {
+        let (address, pin, worker) =
+            mock_pool(COMPACT_MAINNET_NETWORK_ID, advertised, advertised, true);
+        let config = config(address, pin, true)
+            .with_compact_mainnet_compatibility()
+            .unwrap();
+        let mut client = PoolClient::connect(config).unwrap();
+        seen.push(client.consensus_fingerprint());
+        write_frame(
+            &mut client.stream,
+            &ClientMessage::SubmitShare { job_id: [7; 32], nonce: 42 },
+        )
+        .unwrap();
+        worker.join().unwrap().unwrap();
+    }
+    assert_eq!(
+        seen,
+        vec![COMPACT_MAINNET_PREDECESSOR_FINGERPRINT, compact(), COMPACT_MAINNET_PREDECESSOR_FINGERPRINT]
+    );
+}
